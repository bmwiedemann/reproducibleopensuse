#!/bin/bash
# rbverify - run the rbk double build and print one compact verdict
#
# usage: rbverify [-n ROUNDS] [-r] [PKGDIR]
#   -n N   build N times; every round must be reproducible and produce the same
#          rpms as the round before (catches low-entropy races a single green
#          round would miss)
#   -r     report only: do not build, just read the result files of the last run
#
# exit: 0 reproducible, 1 unreproducible, 2 FTBFS, 3 skipped/not applicable,
#       4 inconclusive (build flags differ from the previous run, or no result)
#
# All rbk/rbkt environment variables pass through (slot, parallelism, nolto,
# nopgo, debuginfo, oscbuildparams, ...). Build output goes to .rb.verify.log;
# only the verdict block is printed.

rounds=1
report=false
while getopts "n:r" o; do
    case $o in
        n) rounds=$OPTARG ;;
        r) report=true ;;
        *) exit 64 ;;
    esac
done
shift $((OPTIND-1))
cd "${1:-.}" || exit 4
pkg=$(basename "$(pwd)")

rpmbuildflags() { grep -m1 -o 'exec rpmbuild .*' "$1" 2>/dev/null; }
status() { jsonresultcache . >/dev/null 2>&1 ; sed -n 's/.*"status" : "\([a-zA-Z]*\)".*/\1/p' .build-jsonresult 2>/dev/null | head -1; }
rpmsums() { cat RPMS/checksums RPMS.2/checksums 2>/dev/null | awk '{print $1}' | md5sum | cut -c1-8; }
value() { cat "$1" 2>/dev/null || echo -; }

verdict()
{
    local st=$(status)
    echo "rbverify: $pkg status=${st:-none} differed=$(value .build-differed) compare=$(value .build-compare-retval) $*"
    case "$st" in
        reproducible) return 0 ;;
        unreproducible)
            local o=RPMS/$pkg-compare.out
            if [ -e "$o" ] ; then
                grep -E '^(Comparing|RPM |overall)|^[^ ]* differs|differ: byte' "$o" | head -40
                local n=$(grep -cE '^[^ ]* differs' "$o")
                [ "$n" -gt 40 ] && echo "(... $n differing files, see $o)"
            fi
            return 1 ;;
        FTBFS|waitdep)
            for d in RPMS RPMS.2 ; do
                if [ "$(value $d/.osc-build-retval)" != 0 ] ; then
                    echo "--- $d/.build.log (tail) ---"
                    grep -v '^\[ *[0-9]*s\] *$' $d/.build.log 2>/dev/null | tail -15
                    break
                fi
            done
            return 2 ;;
        notforus|nobinaries) return 3 ;;
        *) return 4 ;;
    esac
}

if $report ; then
    verdict
    exit
fi

prevflags=$(rpmbuildflags RPMS/.build.log)
prevsums=
for ((round=1; round<=rounds; round++)) ; do
    touch .rb.verify.start
    start=$(date +%s)
    rbkt >> .rb.verify.log 2>&1
    seconds=$(( $(date +%s) - start ))
    if ! [ .build-differed -nt .rb.verify.start ] ; then
        # rbk exited before building (exceptions/memory -> 37, no AVX -> 12, preload failure)
        echo "rbverify: $pkg status=skipped osc-build-retval=$(value .osc-build-retval) - no new result after ${seconds}s, see .rb.verify.log"
        tail -5 .rb.verify.log
        exit 3
    fi
    sums=$(rpmsums)
    if [ -n "$prevsums" ] && [ "$sums" != "$prevsums" ] ; then
        verdict "round=$round/$rounds seconds=$seconds"
        echo "rbverify: round $round produced different rpms than round $((round-1)) ($sums vs $prevsums) - low-entropy nondeterminism"
        exit 1
    fi
    prevsums=$sums
    verdict "round=$round/$rounds seconds=$seconds rpms=$sums"
    ret=$?
    [ $ret = 0 ] || exit $ret
done

flags=$(rpmbuildflags RPMS/.build.log)
if [ -n "$prevflags" ] && [ "$flags" != "$prevflags" ] ; then
    echo "rbverify: WARNING build flags differ from the previous run - a clean result under different flags proves nothing:"
    diff <(tr ' ' '\n' <<<"$prevflags") <(tr ' ' '\n' <<<"$flags") | grep '^[<>]' | head -20
    exit 4
fi
exit 0
