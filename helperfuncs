gs()
{
    git init
    git add .
    git commit -m "orig"
    git tag orig
    #git gc >/dev/null 2>&1 &
}

qs()
{
    local fuzz=--fuzz=1 pkgdir=$PWD d
    quilt -v setup $fuzz $(basename $(pwd)).spec
    # quilt >= 0.67 unpacks into <name>-<version>-build/<tarball-dir>/ and
    # puts series + patches there; without any Patch: line it creates neither
    d=$(find . -mindepth 2 -maxdepth 4 -name series -not -path '*/.osc/*' -printf '%h\n' | head -1)
    if [[ -z $d ]] ; then
        d=$(find . -mindepth 1 -maxdepth 1 -type d -not -name binaries -not -name 'RPMS*' -not -name deps -not -name '.osc' | head -1)
        if [[ $d == *-build ]] ; then
            local inner=$(find "$d" -mindepth 1 -maxdepth 1 -type d -not -name SPECPARTS)
            [[ $inner == */* && $inner != *$'\n'* ]] && d=$inner
        fi
    fi
    if [[ $d ]] ; then
        cd "$d"
        touch series
        [[ -e patches ]] || ln -s "$(realpath --relative-to=. "$pkgdir")" patches
        quilt push -a $fuzz
    fi
}

bcocd()
{
    osc bco
    cd home\:*\:branches\:*/$(basename $(pwd)) &&
    osc up
    cp -a ../../*.{spec,patch,diff,changes} .
    osc ar
    osc meta prjconf -F ~/reproducibleopensuse/prjconf
}

function vonoa
{
    d=${1:-.}
    view $d/.rb.noarchcheck.diff
}

function rbn
{
    make -f ~/reproducibleopensuse/Makefile.rebuild .build-differed-nachbau
}
export -f rbn
function rbnoa
{
    make -f ~/reproducibleopensuse/Makefile.rebuild .rb.noarchcheck
}
export -f rbnoa
